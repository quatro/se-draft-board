# Copy to .env. Everything here is read once at boot; restart after changing.
PORT=3030
NODE_ENV=production
# Public URL the app is served from (used to build the webhook URL shown in admin).
BASE_URL=http://localhost:3030

# Optional shared code viewers must enter to see the board. Leave blank to
# make the read-only board public. Admins always need their own login.
VIEWER_PASSWORD=

# --- SportsEngine registration webhooks -----------------------------------
# Random string that forms part of the webhook URL:
#   POST {BASE_URL}/webhooks/sportsengine/{SPORTSENGINE_WEBHOOK_TOKEN}
# Unset = the endpoint answers 503 (fails closed).
SPORTSENGINE_WEBHOOK_TOKEN=
# Shared secret for HMAC-SHA256 signature checks, once SportsEngine gives you one.
# Unset = deliveries are accepted on the URL token alone and marked unverified.
SPORTSENGINE_WEBHOOK_SECRET=
# Header the signature arrives in (confirm against SportsEngine's docs).
SPORTSENGINE_SIGNATURE_HEADER=x-sportsengine-signature

# Admin accounts shared by every league tool, and the cookie domain that makes
# one login work on all of them (leave both blank to keep logins per-app).
AUTH_DB_PATH=/home/greg/apps/league-data/auth.db
COOKIE_DOMAIN=.crushworldseries.com
